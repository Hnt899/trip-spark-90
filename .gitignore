```gitignore
# Dependencies
node_modules/

# Build outputs
dist/
build/
.next/
.nuxt/
public/dist/
out/

# Logs
*.log

# Environment variables
.env
.env.local
.env.*
!.env.example

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
pip-log.txt
pip-delete-this-directory.txt
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.log
.git/modules/
*.sublime-workspace
.pytest_cache/
.mypy_cache/
.hypothesis/

# TypeScript/JavaScript
*.tsbuildinfo
*.js.map
*.mjs.map
*.jsx.map
*.tsx.map

# Temporary files
*.tmp
*.temp
*.bak
*.backup

# Compiled binary files
*.exe
*.dll
*.so
*.dylib
*.class
*.o
*.a
*.obj
*.out
```